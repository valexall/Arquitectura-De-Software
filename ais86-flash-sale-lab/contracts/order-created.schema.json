{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated v1",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/services/orders"
    },
    "type": {
      "const": "pe.unamba.flash.order.created.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "items",
        "total_cents"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "product_id",
              "quantity"
            ],
            "properties": {
              "product_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "total_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
